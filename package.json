{
    "name": "@lynktrace/node",
    "version": "0.1.0-beta.2",
    "description": "Enterprise-grade observability SDK with error tracking, tracing, metrics, and breadcrumbs",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./register": {
            "types": "./dist/register.d.ts",
            "import": "./dist/register.js",
            "require": "./dist/register.js",
            "default": "./dist/register.js"
        },
        "./internals": {
            "types": "./dist/internals.d.ts",
            "import": "./dist/internals.js",
            "require": "./dist/internals.js",
            "default": "./dist/internals.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "node -e \"const fs=require('fs'); const path=require('path'); const root=process.cwd(); const remove=(p)=>fs.rmSync(p,{recursive:true,force:true}); remove(path.join(root,'dist')); const walk=(dir)=>{ if(!fs.existsSync(dir)) return; for(const entry of fs.readdirSync(dir,{withFileTypes:true})){ const full=path.join(dir,entry.name); if(entry.isDirectory()) walk(full); else if(/\\.(js|js\\.map|d\\.ts|d\\.ts\\.map)$/.test(entry.name)) fs.rmSync(full,{force:true}); } }; walk(path.join(root,'src'));\"",
        "build": "npm run clean && npx tsc",
        "test": "npm run test:unit && npm run test:integration",
        "test:unit": "npx tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-tests/tests/unit/*.test.js",
        "test:integration": "npx tsc && npx tsc -p tsconfig.test.json && node --expose-gc --test --test-concurrency=1 dist-tests/tests/integration/*.test.js",
        "test:all": "npm test",
        "test:trace": "npx tsc -p tsconfig.test.json && node --test dist-tests/tests/unit/trace-span.test.js",
        "prepublishOnly": "npm run  build",
        "dev": "nodemon src/index.ts",
        "start": "node dist/index.js"
    },
    "files": [
        "dist/**/*"
    ],
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "@fastify/otel": "0.20.1",
        "@opentelemetry/api": "1.9.1",
        "@opentelemetry/context-async-hooks": "2.11.0",
        "@opentelemetry/core": "2.11.0",
        "@opentelemetry/instrumentation": "0.222.0",
        "@opentelemetry/instrumentation-express": "0.70.0",
        "@opentelemetry/instrumentation-graphql": "0.70.0",
        "@opentelemetry/instrumentation-http": "0.222.0",
        "@opentelemetry/instrumentation-ioredis": "0.70.0",
        "@opentelemetry/instrumentation-mongodb": "0.75.0",
        "@opentelemetry/instrumentation-mysql2": "0.68.0",
        "@opentelemetry/instrumentation-pg": "0.74.0",
        "@opentelemetry/instrumentation-redis": "0.70.0",
        "@opentelemetry/instrumentation-undici": "0.32.0",
        "@opentelemetry/resources": "2.11.0",
        "@opentelemetry/sdk-metrics": "2.11.0",
        "@opentelemetry/sdk-trace-base": "2.11.0",
        "@opentelemetry/sdk-trace-node": "2.11.0",
        "@opentelemetry/semantic-conventions": "1.43.0",
        "@prisma/instrumentation": "7.10.0",
        "import-in-the-middle": "^3.4.0",
        "opentelemetry-instrumentation-bullmq": "0.7.15",
        "source-map-js": "1.2.1",
        "zod": "4.5.4"
    },
    "devDependencies": {
        "@types/express": "5.0.6",
        "@types/node": "26.4.1",
        "@types/pg": "^8.23.1",
        "axios": "^1.20.0",
        "express": "5.2.1",
        "fast-check": "4.9.0",
        "fastify": "5.12.1",
        "ioredis": "^6.0.0",
        "nodemon": "3.1.14",
        "pg": "^8.23.0",
        "prettier": "3.9.6",
        "redis": "^6.2.1",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "@prisma/client": "^7.0.0",
        "bullmq": "^2.0.0 || ^3.0.0 || ^4.0.0 || ^5.0.0 || ^6.0.0"
    },
    "peerDependenciesMeta": {
        "@prisma/client": {
            "optional": true
        },
        "bullmq": {
            "optional": true
        }
    }
}