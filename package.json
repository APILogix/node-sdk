{
  "name": "@vikasbaplawat1/pulse-sdk",
  "version": "3.0.0",
  "description": "Enterprise-grade observability SDK with error tracking, tracing, metrics, and breadcrumbs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internals": {
      "types": "./dist/internals.d.ts",
      "import": "./dist/internals.js",
      "default": "./dist/internals.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); const path=require('path'); const root=process.cwd(); const remove=(p)=>fs.rmSync(p,{recursive:true,force:true}); remove(path.join(root,'dist')); const walk=(dir)=>{ if(!fs.existsSync(dir)) return; for(const entry of fs.readdirSync(dir,{withFileTypes:true})){ const full=path.join(dir,entry.name); if(entry.isDirectory()) walk(full); else if(/\\.(js|js\\.map|d\\.ts|d\\.ts\\.map)$/.test(entry.name)) fs.rmSync(full,{force:true}); } }; walk(path.join(root,'src'));\"",
    "build": "npm run clean && npx tsc",
    "test": "npm run build && node tests/sdk-smoke.mjs",
    "test:unit": "npx tsc -p tsconfig.test.json && node --test dist-tests/tests/unit/*.test.js",
    "test:trace": "npx tsc -p tsconfig.test.json && node --test dist-tests/tests/unit/trace-span.test.js",
    "prepublishOnly": "npm run  build",
    "dev": "nodemon src/index.ts",
    "start": "node dist/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.7.1",
    "@opentelemetry/core": "2.7.1",
    "@opentelemetry/instrumentation": "0.200.0",
    "@opentelemetry/instrumentation-express": "0.50.0",
    "@opentelemetry/instrumentation-fastify": "0.56.0",
    "@opentelemetry/instrumentation-graphql": "0.66.0",
    "@opentelemetry/instrumentation-http": "0.200.0",
    "@opentelemetry/instrumentation-mongodb": "0.71.0",
    "@opentelemetry/instrumentation-mysql2": "0.64.0",
    "@opentelemetry/instrumentation-pg": "0.70.0",
    "@opentelemetry/instrumentation-redis": "0.66.0",
    "@opentelemetry/instrumentation-redis-4": "0.49.0",
    "@opentelemetry/instrumentation-undici": "0.28.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-metrics": "2.7.1",
    "@opentelemetry/sdk-trace-base": "2.7.1",
    "@opentelemetry/sdk-trace-node": "2.7.1",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@prisma/instrumentation": "7.8.0",
    "opentelemetry-instrumentation-bullmq": "0.7.15",
    "source-map-js": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@typescript-eslint/parser": "^8.0.0",
    "fast-check": "^4.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "pulse-sdk": "*"
  },
  "peerDependenciesMeta": {
    "pulse-sdk": {
      "optional": true
    }
  }
}
