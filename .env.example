# Pulse SDK Backend Configuration

# Backend API base URL (control plane endpoint)
# The SDK will use this URL for all API communication including:
# - Remote configuration fetching
# - Telemetry data submission (traces, errors, metrics, logs, etc.)
#
# Default: http://127.0.0.1:5000
#
# You can use any of these environment variables (in order of priority):
# 1. PULSE_ENDPOINT
# 2. PULSE_API_URL
# 3. PULSE_BASE_URL
# 4. BACKEND_URL
# 5. SDK_BASE_URL (shown below)
#
# Example values:
# - Local development: http://127.0.0.1:5000
# - Production: https://api.veyontix.com
# - Custom backend: https://your-backend.example.com
SDK_BASE_URL=http://192.168.1.8:5000
